# Local MongoDB must run as a replica set for transactions.
MONGO_URI=mongodb://127.0.0.1:27017/iqlocker?replicaSet=rs0
PORT=3005
# Required: use a unique, cryptographically random secret (at least 32 bytes).
JWT_SECRET_KEY=
AZURE_STORAGE_ACCOUNT_URL=https://YOUR_ACCOUNT.blob.core.windows.net
AZURE_STORAGE_CONTAINER=materials
MATERIAL_MAX_FILE_BYTES=20000000
MATERIAL_ACCOUNT_LIMIT_BYTES=500000000
# For local Azurite only: set NODE_ENV=development and a local connection string.
# Never commit real credentials or put them in frontend variables.
